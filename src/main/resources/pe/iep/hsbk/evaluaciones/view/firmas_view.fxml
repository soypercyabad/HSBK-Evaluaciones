<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.web.WebView?>
<?import java.lang.String?>
<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.iep.hsbk.evaluaciones.controller.FirmaController">

    <!-- CONTENIDO REAL -->
    <VBox spacing="16" styleClass="page">
        <padding>
            <Insets bottom="24" left="24" right="24" top="16"/>
        </padding>

        <!-- TOP BAR -->
        <HBox spacing="12" maxWidth="Infinity" alignment="CENTER_LEFT">
            <!-- Título/Usuario a la izquierda -->
            <Label fx:id="lblTitleScreen"
                   styleClass="top-title"
                   HBox.hgrow="NEVER"/>

            <!-- Spacer que empuja el siguiente nodo a la derecha -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Periodo a la derecha con ícono a la izquierda -->
            <Label fx:id="lblTitleProfile"
                   styleClass="top-title"
                   text="Administrador"
                   graphicTextGap="8"
                   HBox.hgrow="NEVER">
                <graphic>
                    <Group scaleX="0.82" scaleY="0.82">
                        <SVGPath content="M12 2C9.38 2 7.25 4.13 7.25 6.75C7.25 9.32 9.26 11.4 11.88 11.49C11.96 11.48 12.04 11.48 12.1 11.49C12.12 11.49 12.13 11.49 12.15 11.49C12.16 11.49 12.16 11.49 12.17 11.49C14.73 11.4 16.74 9.32 16.75 6.75C16.75 4.13 14.62 2 12 2Z"
                                 style="-fx-fill: #A5A7AB; -fx-stroke-width: 2;
                                -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                        <SVGPath content="M17.0809 14.1499C14.2909 12.2899 9.74094 12.2899 6.93094 14.1499C5.66094 14.9999 4.96094 16.1499 4.96094 17.3799C4.96094 18.6099 5.66094 19.7499 6.92094 20.5899C8.32094 21.5299 10.1609 21.9999 12.0009 21.9999C13.8409 21.9999 15.6809 21.5299 17.0809 20.5899C18.3409 19.7399 19.0409 18.5999 19.0409 17.3599C19.0309 16.1299 18.3409 14.9899 17.0809 14.1499Z"
                                 style="-fx-fill: #292D32; -fx-stroke-width: 2;
                                -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                    </Group>
                </graphic>
            </Label>
        </HBox>

        <!-- SECCIONES -->
        <GridPane hgap="15.0" vgap="0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="55"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="45"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- Izquierda: formulario + tabla -->
            <AnchorPane styleClass="left-pane" fx:id="left_pane" GridPane.columnIndex="0">
                <children>
                    <VBox spacing="12.0" AnchorPane.bottomAnchor="16" AnchorPane.leftAnchor="16"
                          AnchorPane.rightAnchor="16" AnchorPane.topAnchor="16">
                        <children>

                            <Label styleClass="block-title" text="Registrar nueva firma"/>

                            <!-- Fila: Nombre + Estado -->
                            <GridPane hgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="NEVER"/>
                                </rowConstraints>
                                <children>
                                    <VBox prefWidth="100.0" spacing="6.0" GridPane.columnIndex="0">
                                        <children>
                                            <Label text="Usuario"/>
                                            <ComboBox fx:id="usuarioComboBox" prefWidth="Infinity" promptText="Seleccionar usuario" VBox.vgrow="ALWAYS" />
                                        </children>
                                    </VBox>

                                    <VBox prefWidth="100.0" spacing="6.0" GridPane.columnIndex="1">
                                        <children>
                                            <Label text="Estado"/>
                                            <ComboBox fx:id="estadoComboBox" prefWidth="Infinity" value="Activo" VBox.vgrow="ALWAYS"> </ComboBox>
                                        </children>
                                    </VBox>
                                </children>
                            </GridPane>

                            <!-- Fila: ruta Png + Guardar -->
                            <GridPane hgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="100"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="NEVER"/>
                                </rowConstraints>
                                <children>
                                    <VBox spacing="6.0">
                                        <children>
                                            <Label text="Archivo .png de la firma"/>
                                            <HBox>
                                                <children>
                                                    <Button fx:id="btnExaminar" onAction="#onExaminar"
                                                            styleClass="examinar-btn" text="Examinar"/>
                                                    <TextField fx:id="txtRutaPng" editable="false" prefWidth="280.0"
                                                               promptText="Subir la imagen de la firma (.png)"
                                                               styleClass="text-field-examinar"/>
                                                    <Pane HBox.hgrow="ALWAYS"/>
                                                    <Button fx:id="btnRegistrar" onAction="#onGuardar"
                                                            alignment="CENTER" maxWidth="Infinity" prefWidth="100"
                                                            styleClass="primary-btn" text="Guardar"/>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                </children>
                            </GridPane>

                            <!-- Tabla -->
                            <VBox spacing="12" VBox.vgrow="ALWAYS">
                                <children>
                                    <Separator prefWidth="200.0">
                                        <VBox.margin>
                                            <Insets top="10.0"/>
                                        </VBox.margin>
                                    </Separator>
                                    <Label styleClass="block-title" text="Lista de firmas"/>
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <children>
                                            <TextField fx:id="txtBuscar" promptText="Buscar por nombre o estado" HBox.hgrow="ALWAYS"/>
                                            <Button onAction="#onBuscar" styleClass="primary-btn" text="Buscar"/>
                                            <Pane HBox.hgrow="ALWAYS"/>

                                            <Button onAction="#onRecargar" styleClass="primary-btn">
                                                <graphic>
                                                    <!-- Escalamos desde 24x24 a ~18px -->
                                                    <Group scaleX="0.75" scaleY="0.75">
                                                        <!-- Arco superior -->
                                                        <SVGPath content="M4,12 A8,8 0 0 1 18.93,8"
                                                                 style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2;
                                                                 -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                                        <!-- Arco inferior -->
                                                        <SVGPath content="M20,12 A8,8 0 0 1 5.07,16"
                                                                 style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2;
                                                                 -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                                        <!-- Flecha superior derecha -->
                                                        <SVGPath content="M14 8 L19 8 L19 3"
                                                                 style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2;
                                                                 -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                                        <!-- Flecha inferior izquierda -->
                                                        <SVGPath content="M10 16 L5 16 L5 21"
                                                                 style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2;
                                                                 -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                                    </Group>
                                                </graphic>
                                            </Button>
                                        </children>
                                    </HBox>

                                    <TableView fx:id="tblFirma" styleClass="table-card" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colNombres" prefWidth="180" text="Nombre"/>
                                            <TableColumn fx:id="colRol" prefWidth="90" text="Rol"/>
                                            <TableColumn fx:id="colEstado" prefWidth="90" text="Estado"/>
                                            <TableColumn fx:id="colAcciones" text="Acciones"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="Sin resultados por ahora"/>
                                        </placeholder>
                                    </TableView>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </AnchorPane>

            <!-- Derecha: previsualización -->
            <AnchorPane styleClass="left-pane" fx:id="right_pane" GridPane.columnIndex="1">
                <children>
                    <VBox spacing="16" AnchorPane.bottomAnchor="16" AnchorPane.leftAnchor="16"
                          AnchorPane.rightAnchor="16" AnchorPane.topAnchor="16">
                        <children>
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                                   text="Previsualización de plantilla"/>
                            <WebView fx:id="webView" prefHeight="600.0" prefWidth="600.0"/>
                        </children>
                    </VBox>
                </children>
            </AnchorPane>
        </GridPane>
    </VBox>

    <!-- OVERLAY DE CARGA (oculto por defecto) -->
    <StackPane fx:id="overlay" styleClass="overlay" visible="false">
        <ProgressIndicator fx:id="piMain" prefHeight="64" prefWidth="64"/>
    </StackPane>
</StackPane>
