<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1280" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.iep.hsbk.evaluaciones.controller.MainController">

    <!-- CSS (relativo al FXML: /view -> ../css) -->
    <stylesheets>
        <URL value="@../css/theme.css" />
    </stylesheets>

    <!-- LADO IZQUIERDO: MENÚ -->
    <left>
        <VBox alignment="TOP_CENTER" spacing="16" styleClass="sidebar">
            <children>
                <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" styleClass="logo">
                    <image>
                        <!-- pon tu logo en assets y cambia la ruta si quieres -->
                        <Image url="@../assets/logo.png" />
                    </image>
               <VBox.margin>
                  <Insets bottom="24.0" left="24.0" right="36.0" />
               </VBox.margin>
                </ImageView>

                <Button fx:id="btnPrimaria" onAction="#onPrimaria" styleClass="nav-btn" text="Primaria" maxWidth="Infinity"  />
                <Button fx:id="btnSecundaria" onAction="#onSecundaria" styleClass="nav-btn" text="Secundaria" maxWidth="Infinity"  />
                <Button fx:id="btnFirmas" onAction="#onFirmas" styleClass="nav-btn" text="Firmas" maxWidth="Infinity"  />

                <Pane VBox.vgrow="ALWAYS" /> <!-- separador flexible -->

                <Button onAction="#onLogout" styleClass="logout-btn" text="Cerrar sesión" />
            </children>

            <padding>
                <Insets bottom="24.0" left="12.0" right="12.0" top="24.0" />
            </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </VBox>
    </left>

    <!-- CONTENEDOR DE VISTAS -->
    <center>
        <StackPane fx:id="contentContainer" styleClass="content-container" />
    </center>
</BorderPane>
