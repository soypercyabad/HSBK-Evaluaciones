<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.Group?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.iep.hsbk.evaluaciones.controller.StudentsListController">

    <!-- CONTENIDO REAL -->
    <VBox spacing="16" styleClass="page">
        <padding>
            <Insets bottom="24" left="24" right="24" top="16" />
        </padding>

        <!-- TOP BAR -->
        <HBox spacing="12" maxWidth="Infinity" alignment="CENTER_LEFT">
            <!-- Título/Usuario a la izquierda -->
            <Label fx:id="lblTitleUsuario"
                   styleClass="top-title"
                   text="Gestión de plantillas de boletas"
                   HBox.hgrow="NEVER"/>

            <!-- Spacer que empuja el siguiente nodo a la derecha -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Periodo a la derecha con ícono a la izquierda -->
            <Label fx:id="lblTitlePeriodo"
                   styleClass="top-title"
                   text="Administrador"
                   graphicTextGap="8"
                   HBox.hgrow="NEVER">
                <graphic>
                    <Group scaleX="0.9" scaleY="0.9">
                        <!-- path 1 -->
                        <SVGPath content="M6.94028 2C7.35614 2 7.69326 2.32421 7.69326 2.72414V4.18487C8.36117 4.17241 9.10983 4.17241 9.95219 4.17241H13.9681C14.8104 4.17241 15.5591 4.17241 16.227 4.18487V2.72414C16.227 2.32421 16.5641 2 16.98 2C17.3958 2 17.733 2.32421 17.733 2.72414V4.24894C19.178 4.36022 20.1267 4.63333 20.8236 5.30359C21.5206 5.97385 21.8046 6.88616 21.9203 8.27586L22 9H2.92456H2V8.27586C2.11571 6.88616 2.3997 5.97385 3.09665 5.30359C3.79361 4.63333 4.74226 4.36022 6.1873 4.24894V2.72414C6.1873 2.32421 6.52442 2 6.94028 2Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 2 -->
                        <SVGPath content="M21.9995 14.0001V12.0001C21.9995 11.161 21.9963 9.66527 21.9834 9H2.00917C1.99626 9.66527 1.99953 11.161 1.99953 12.0001V14.0001C1.99953 17.7713 1.99953 19.6569 3.1711 20.8285C4.34267 22.0001 6.22829 22.0001 9.99953 22.0001H13.9995C17.7708 22.0001 19.6564 22.0001 20.828 20.8285C21.9995 19.6569 21.9995 17.7713 21.9995 14.0001Z"
                                 style="-fx-fill: #A5A7AB"/>
                        <!-- path 3 -->
                        <SVGPath content="M18 17C18 17.5523 17.5523 18 17 18C16.4477 18 16 17.5523 16 17C16 16.4477 16.4477 16 17 16C17.5523 16 18 16.4477 18 17Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 4 -->
                        <SVGPath content="M18 13C18 13.5523 17.5523 14 17 14C16.4477 14 16 13.5523 16 13C16 12.4477 16.4477 12 17 12C17.5523 12 18 12.4477 18 13Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 5 -->
                        <SVGPath content="M13 17C13 17.5523 12.5523 18 12 18C11.4477 18 11 17.5523 11 17C11 16.4477 11.4477 16 12 16C12.5523 16 13 16.4477 13 17Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 6 -->
                        <SVGPath content="M13 13C13 13.5523 12.5523 14 12 14C11.4477 14 11 13.5523 11 13C11 12.4477 11.4477 12 12 12C12.5523 12 13 12.4477 13 13Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 7 -->
                        <SVGPath content="M8 17C8 17.5523 7.55228 18 7 18C6.44772 18 6 17.5523 6 17C6 16.4477 6.44772 16 7 16C7.55228 16 8 16.4477 8 17Z"
                                 style="-fx-fill: #1C274C;"/>
                        <!-- path 8 -->
                        <SVGPath content="M8 13C8 13.5523 7.55228 14 7 14C6.44772 14 6 13.5523 6 13C6 12.4477 6.44772 12 7 12C7.55228 12 8 12.4477 8 13Z"
                                 style="-fx-fill: #1C274C;"/>
                    </Group>
                </graphic>
            </Label>

            <!-- Spacer que empuja el siguiente nodo a la derecha -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Periodo a la derecha con ícono a la izquierda -->
            <Label fx:id="lblTitleRol"
                   styleClass="top-title"
                   text="Docente - Tutor"
                   graphicTextGap="8"
                   HBox.hgrow="NEVER">
                <graphic>
                    <Group scaleX="0.82" scaleY="0.82">
                        <SVGPath content="M12 2C9.38 2 7.25 4.13 7.25 6.75C7.25 9.32 9.26 11.4 11.88 11.49C11.96 11.48 12.04 11.48 12.1 11.49C12.12 11.49 12.13 11.49 12.15 11.49C12.16 11.49 12.16 11.49 12.17 11.49C14.73 11.4 16.74 9.32 16.75 6.75C16.75 4.13 14.62 2 12 2Z"
                                 style="-fx-fill: #A5A7AB; -fx-stroke-width: 2;
                                -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                        <SVGPath content="M17.0809 14.1499C14.2909 12.2899 9.74094 12.2899 6.93094 14.1499C5.66094 14.9999 4.96094 16.1499 4.96094 17.3799C4.96094 18.6099 5.66094 19.7499 6.92094 20.5899C8.32094 21.5299 10.1609 21.9999 12.0009 21.9999C13.8409 21.9999 15.6809 21.5299 17.0809 20.5899C18.3409 19.7399 19.0409 18.5999 19.0409 17.3599C19.0309 16.1299 18.3409 14.9899 17.0809 14.1499Z"
                                 style="-fx-fill: #292D32; -fx-stroke-width: 2;
                                -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                    </Group>
                </graphic>
            </Label>
        </HBox>

        <!-- GRADOS -->
        <ScrollPane styleClass="tabs-scroll"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    fitToHeight="true"
                    fitToWidth="false"
                    pannable="true" minHeight="54">
            <content>
                <HBox fx:id="paneGrados" spacing="8.0" styleClass="tabs-row" fillHeight="true" alignment="CENTER_LEFT"/>
            </content>
        </ScrollPane>

        <!-- CONTENIDO PRINCIPAL -->
        <HBox spacing="24">
            <!-- SECCIONES -->
            <ScrollPane styleClass="sections-scroll"
                        prefWidth="160" fitToWidth="true"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="paneSecciones" prefWidth="140" spacing="8"/>
                </content>
            </ScrollPane>

            <!-- Lista de alumnos -->
            <VBox spacing="12" VBox.vgrow="ALWAYS">
                <Label styleClass="block-title" text="Lista de Alumnos"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="txtBuscar" promptText="Buscar por apellido, nombre o código" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#onBuscar" styleClass="primary-btn" text="Buscar"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button onAction="#onDescargar" styleClass="outline-btn" text="Descargar boleta">
                        <graphic>
                            <Group scaleX="0.8" scaleY="0.8">
                                <SVGPath content="M12.5535 16.5061C12.4114 16.6615 12.2106 16.75 12 16.75C11.7894 16.75 11.5886 16.6615 11.4465 16.5061L7.44648 12.1311C7.16698 11.8254 7.18822 11.351 7.49392 11.0715C7.79963 10.792 8.27402 10.8132 8.55352 11.1189L11.25 14.0682V3C11.25 2.58579 11.5858 2.25 12 2.25C12.4142 2.25 12.75 2.58579 12.75 3V14.0682L15.4465 11.1189C15.726 10.8132 16.2004 10.792 16.5061 11.0715C16.8118 11.351 16.833 11.8254 16.5535 12.1311L12.5535 16.5061Z"
                                         style="-fx-fill: -fx-text-fill; -fx-stroke: -fx-text-fill;"/>
                                <SVGPath content="M3.75 15C3.75 14.5858 3.41422 14.25 3 14.25C2.58579 14.25 2.25 14.5858 2.25 15V15.0549C2.24998 16.4225 2.24996 17.5248 2.36652 18.3918C2.48754 19.2919 2.74643 20.0497 3.34835 20.6516C3.95027 21.2536 4.70814 21.5125 5.60825 21.6335C6.47522 21.75 7.57754 21.75 8.94513 21.75H15.0549C16.4225 21.75 17.5248 21.75 18.3918 21.6335C19.2919 21.5125 20.0497 21.2536 20.6517 20.6516C21.2536 20.0497 21.5125 19.2919 21.6335 18.3918C21.75 17.5248 21.75 16.4225 21.75 15.0549V15C21.75 14.5858 21.4142 14.25 21 14.25C20.5858 14.25 20.25 14.5858 20.25 15C20.25 16.4354 20.2484 17.4365 20.1469 18.1919C20.0482 18.9257 19.8678 19.3142 19.591 19.591C19.3142 19.8678 18.9257 20.0482 18.1919 20.1469C17.4365 20.2484 16.4354 20.25 15 20.25H9C7.56459 20.25 6.56347 20.2484 5.80812 20.1469C5.07435 20.0482 4.68577 19.8678 4.40901 19.591C4.13225 19.3142 3.9518 18.9257 3.85315 18.1919C3.75159 17.4365 3.75 16.4354 3.75 15Z"
                                         style="-fx-fill: -fx-text-fill; -fx-stroke: -fx-text-fill;"/>
                            </Group>
                        </graphic>
                    </Button>
                </HBox>

                <TableView fx:id="tblAlumnos" styleClass="table-card" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSel" prefWidth="50" text=""/>
                        <TableColumn fx:id="colApellidos" prefWidth="240" text="Apellidos"/>
                        <TableColumn fx:id="colNombres" prefWidth="240" text="Nombres"/>
                        <TableColumn fx:id="colCodigo" prefWidth="140" text="Código"/>
                        <TableColumn fx:id="colAcciones" prefWidth="100" text="Acciones"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>

    <!-- OVERLAY DE CARGA -->
    <StackPane fx:id="overlay" managed="false" visible="false" styleClass="overlay">
        <ProgressIndicator fx:id="piMain" prefHeight="64" prefWidth="64"/>
    </StackPane>
</StackPane>
