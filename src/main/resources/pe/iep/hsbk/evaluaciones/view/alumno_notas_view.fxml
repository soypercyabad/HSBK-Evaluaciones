<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.iep.hsbk.evaluaciones.controller.AlumnoNotasController">

    <!-- CONTENIDO REAL -->
