            </Label>

            <!-- Spacer que empuja el siguiente nodo a la derecha -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Periodo a la derecha con ícono a la izquierda -->
            <Label fx:id="lblTitleRol" graphicTextGap="8" styleClass="top-title" text="Sección: A" HBox.hgrow="NEVER">
                <graphic>
                    <StackPane maxHeight="24" maxWidth="24" minHeight="24" minWidth="24" prefHeight="24" prefWidth="24">
                        <Group scaleX="0.046875" scaleY="0.046875">
