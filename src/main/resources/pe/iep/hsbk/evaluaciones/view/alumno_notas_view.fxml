<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<StackPane prefHeight="517.0" prefWidth="710.0" xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="pe.iep.hsbk.evaluaciones.controller.AlumnoNotasController">

    <!-- CONTENIDO REAL -->
    <VBox spacing="16" styleClass="page">
        <padding>
            <Insets bottom="24" left="24" right="24" top="16"/>
        </padding>

        <!-- TOP BAR -->
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="12">
            <Button fx:id="btnBack" styleClass="outline-btn">
                <graphic>
                    <SVGPath content="M15 18L9 12L15 6"
                             style="-fx-fill: none; -fx-stroke: -fx-text-fill; -fx-stroke-width: 2; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                </graphic>
            </Button>

            <!-- Título/Usuario a la izquierda -->
            <Label fx:id="lblTitleAlumno" graphicTextGap="8" styleClass="top-title" text="Alumno: -" HBox.hgrow="NEVER">
                <graphic>
                    <Group scaleX="0.82" scaleY="0.82">
                        <SVGPath
                                content="M12 2C9.38 2 7.25 4.13 7.25 6.75C7.25 9.32 9.26 11.4 11.88 11.49C11.96 11.48 12.04 11.48 12.1 11.49C12.12 11.49 12.13 11.49 12.15 11.49C12.16 11.49 12.16 11.49 12.17 11.49C14.73 11.4 16.74 9.32 16.75 6.75C16.75 4.13 14.62 2 12 2Z"
                                style="-fx-fill: #A5A7AB; -fx-stroke-width: 2; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                        <SVGPath
                                content="M17.0809 14.1499C14.2909 12.2899 9.74094 12.2899 6.93094 14.1499C5.66094 14.9999 4.96094 16.1499 4.96094 17.3799C4.96094 18.6099 5.66094 19.7499 6.92094 20.5899C8.32094 21.5299 10.1609 21.9999 12.0009 21.9999C13.8409 21.9999 15.6809 21.5299 17.0809 20.5899C18.3409 19.7399 19.0409 18.5999 19.0409 17.3599C19.0309 16.1299 18.3409 14.9899 17.0809 14.1499Z"
                                style="-fx-fill: #292D32; -fx-stroke-width: 2;-fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                    </Group>
                </graphic>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblTitleGrado" graphicTextGap="8" styleClass="top-title" text="Grado: -" HBox.hgrow="NEVER"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTitleSeccion" graphicTextGap="8" styleClass="top-title" text="Sección: -"
                   HBox.hgrow="NEVER"/>
        </HBox>

        <!-- BIMESTRE -->
        <ScrollPane fitToHeight="true" minHeight="54" pannable="true" styleClass="tabs-scroll" vbarPolicy="NEVER">
            <content>
                <HBox fx:id="paneBimestres" alignment="CENTER_LEFT" spacing="8.0" styleClass="tabs-row"/>
            </content>
        </ScrollPane>

        <!-- CONTENIDO PRINCIPAL -->
        <HBox spacing="12">
            <!-- CURSOS -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sections-scroll">
                <content>
                    <VBox fx:id="paneCurso" spacing="8"/>
                </content>
            </ScrollPane>

            <!-- Panel derecho: acción + formulario scrolleable -->
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">

                <!-- Action bar -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="action-bar">
                    <Label fx:id="lblCursoSel" styleClass="block-title" text="Curso: -"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblBimestreSel" styleClass="block-title" text="Bimestre: -"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnGuardarCurso" defaultButton="true" styleClass="primary-btn"
                            text="Registrar notas"/>
                </HBox>

                <!-- Formulario scrolleable -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sections-scroll" vbarPolicy="ALWAYS"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <!-- 👇 Un solo contenedor -->
                        <VBox fillWidth="true" spacing="6" styleClass="left-pane">
                            <Region prefHeight="6"/>

                            <!-- Practicas -->
                            <Label styleClass="block-title" text="Prácticas"/>
                            <GridPane vgap="5.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="120"/>
                                </columnConstraints>

                                <Label text="Pract. 1" GridPane.columnIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Pract. 2" GridPane.columnIndex="2">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Pract. 3" GridPane.columnIndex="3">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Pract. 4" GridPane.columnIndex="4">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Promedio" GridPane.columnIndex="5"/>

                                <TextField fx:id="pract1Field" alignment="CENTER" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pract2Field" alignment="CENTER" GridPane.columnIndex="2"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pract3Field" alignment="CENTER" GridPane.columnIndex="3"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pract4Field" alignment="CENTER" GridPane.columnIndex="4"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="practPromField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="5"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>

                                <rowConstraints>
                                    <RowConstraints/>
                                    <RowConstraints/>
                                </rowConstraints>
                                <padding>
                                    <Insets right="16.0"/>
                                </padding>
                            </GridPane>

                            <!-- Tareas -->
                            <Label styleClass="block-title" text="Tareas"/>
                            <GridPane vgap="5.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="120"/>
                                </columnConstraints>

                                <Label text="Libro" GridPane.columnIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Cuaderno" GridPane.columnIndex="2">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Promedio" GridPane.columnIndex="3"/>

                                <TextField fx:id="libroField" alignment="CENTER" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="cuadernoField" alignment="CENTER" GridPane.columnIndex="2"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="tareaPromField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="3"
                                           GridPane.rowIndex="1"/>
                                <rowConstraints>
                                    <RowConstraints/>
                                    <RowConstraints/>
                                </rowConstraints>
                                <padding>
                                    <Insets right="16.0"/>
                                </padding>
                            </GridPane>

                            <!-- Exámenes -->
                            <Label styleClass="block-title" text="Exámenes"/>
                            <GridPane vgap="5.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                </columnConstraints>

                                <Label text="Exa. Mensual" GridPane.columnIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Exa. Bimestral" GridPane.columnIndex="2"/>

                                <TextField fx:id="exMenField" alignment="CENTER" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="exBimField" alignment="CENTER" GridPane.columnIndex="2"
                                           GridPane.rowIndex="1"/>
                                <rowConstraints>
                                    <RowConstraints/>
                                    <RowConstraints/>
                                </rowConstraints>
                                <padding>
                                    <Insets right="16.0"/>
                                </padding>
                            </GridPane>

                            <!-- Promedio Bimestral -->
                            <Label styleClass="block-title" text="Promedio Bimestral"/>
                            <GridPane vgap="5.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="90"/>
                                    <ColumnConstraints prefWidth="120"/>
                                </columnConstraints>

                                <Label text="Prácticas" GridPane.columnIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Tareas" GridPane.columnIndex="2">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Ex. Mensual" GridPane.columnIndex="3">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Ex. Bimestral" GridPane.columnIndex="4">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </Label>
                                <Label text="Promedio Final" GridPane.columnIndex="5"/>

                                <TextField fx:id="pbPracticasField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pbTareasField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="2"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pbExMensualField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="3"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pbExBimestralField" alignment="CENTER" editable="false"
                                           styleClass="text-field-disabled" GridPane.columnIndex="4"
                                           GridPane.rowIndex="1">
                                    <GridPane.margin>
                                        <Insets right="16.0"/>
                                    </GridPane.margin>
                                </TextField>
                                <TextField fx:id="pbFinalField" alignment="CENTER" editable="false"
                                           style="-fx-background-color:#d7f6f5; -fx-border-color:#3fb5b0; -fx-border-radius:6; -fx-background-radius:6;"
                                           GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                                <rowConstraints>
                                    <RowConstraints/>
                                    <RowConstraints/>
                                </rowConstraints>
                                <padding>
                                    <Insets right="16.0"/>
                                </padding>
                            </GridPane>
                            <padding>
                                <Insets left="12.0"/>
                            </padding>
                            <Region prefHeight="6"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </HBox>
    </VBox>

    <!-- OVERLAY DE CARGA -->
    <StackPane fx:id="overlay" managed="false" styleClass="overlay" visible="false">
        <ProgressIndicator fx:id="piMain" prefHeight="64" prefWidth="64"/>
    </StackPane>
</StackPane>
