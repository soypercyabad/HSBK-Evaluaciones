                                    content="M256,346.831c-11.246,0-22.143-2.391-32.386-7.104L112.793,288.71v101.638 c0,22.314,67.426,50.621,143.207,50.621c75.782,0,143.209-28.308,143.209-50.621V288.71l-110.827,51.017 C278.145,344.44,267.25,346.831,256,346.831z"
                                    style="-fx-fill: #292D32; -fx-stroke-width: 2;-fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                        </Group>
                    </StackPane>
                </graphic>
            </Label>
        </HBox>

        <!-- BIMESTRE -->
        <ScrollPane fitToHeight="true" minHeight="54" pannable="true" styleClass="tabs-scroll" vbarPolicy="NEVER">
            <content>
                <HBox fx:id="paneBimestres" alignment="CENTER_LEFT" spacing="8.0" styleClass="tabs-row"/>
            </content>
        </ScrollPane>

        <!-- CONTENIDO PRINCIPAL -->
        <HBox spacing="12">
            <!-- CURSOS -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sections-scroll">
                <content>
                    <VBox fx:id="paneCurso" spacing="8"/>
                </content>
            </ScrollPane>

            <!-- Formulario de notas -->
            <VBox spacing="6.0">
                <!--Practicas-->
                <Label styleClass="block-title" text="Practicas"/>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="120"/>
                    </columnConstraints>

                    <!-- Encabezados -->
                    <Label text="Pract. 1" GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Pract. 2" GridPane.columnIndex="2">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Pract. 3" GridPane.columnIndex="3">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Pract. 4" GridPane.columnIndex="4">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Promedio" GridPane.columnIndex="5"/>

                    <!-- Inputs -->
                    <TextField fx:id="pract1Field" alignment="CENTER" promptText="" GridPane.columnIndex="1"
                               GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pract2Field" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pract3Field" alignment="CENTER" GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pract4Field" alignment="CENTER" GridPane.columnIndex="4" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="practPromField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled" GridPane.columnIndex="5" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                    <padding>
                        <Insets right="16.0"/>
                    </padding>
                </GridPane>

                <!--Tareas-->
                <Label styleClass="block-title" text="Tareas"/>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="120"/>
                    </columnConstraints>

                    <!-- Encabezados -->
                    <Label text="Libro" GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Cuaderno" GridPane.columnIndex="2">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Promedio" GridPane.columnIndex="3"/>

                    <!-- Inputs -->
                    <TextField fx:id="libroField" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="cuadernoField" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="tareaPromField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                    <padding>
                        <Insets right="16.0"/>
                    </padding>
                </GridPane>

                <!--Examenes-->
                <Label styleClass="block-title" text="Exámenes"/>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                    </columnConstraints>

                    <!-- Encabezados -->
                    <Label text="Exa. Mensual" GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Exa. Bimestral" GridPane.columnIndex="2"/>

                    <!-- Inputs -->
                    <TextField fx:id="exMenField" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="exBimField" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                    <padding>
                        <Insets right="16.0"/>
                    </padding>
                </GridPane>

                <!--Promedio Bimestral-->
                <Label styleClass="block-title" text="Promedio Bimestral"/>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="90"/>
                        <ColumnConstraints prefWidth="120"/>
                    </columnConstraints>

                    <!-- Encabezados -->
                    <Label text="Practicas" GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Tareas" GridPane.columnIndex="2">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Ex. Mensual" GridPane.columnIndex="3">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Ex. Bimestral" GridPane.columnIndex="4">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </Label>
                    <Label text="Promedio Final" GridPane.columnIndex="5"/>

                    <!-- Inputs -->
                    <TextField fx:id="pbPracticasField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled"
                               GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pbTareasField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled"
                               GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pbExMensualField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled"
                               GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pbExBimestralField" alignment="CENTER" editable="false"
                               styleClass="text-field-disabled"
                               GridPane.columnIndex="4" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="16.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="pbFinalField" alignment="CENTER" editable="false"
                               style="-fx-background-color:#d7f6f5; -fx-border-color:#3fb5b0; -fx-border-radius:6; -fx-background-radius:6;"
                               GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>
                    <padding>
                        <Insets right="16.0"/>
                    </padding>
                </GridPane>
            </VBox>
        </HBox>
    </VBox>

    <!-- OVERLAY DE CARGA -->
    <StackPane fx:id="overlay" managed="false" styleClass="overlay" visible="false">
        <ProgressIndicator fx:id="piMain" prefHeight="64" prefWidth="64"/>
    </StackPane>
</StackPane>
